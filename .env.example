# API connects as the non-owner role so row-level security applies.
DATABASE_URL=
# Migrations run as the owner/superuser.
MIGRATE_DATABASE_URL=
HTTP_ADDR=:8080

# JWT signing secret, at least 32 bytes. Generate one: openssl rand -base64 48
# Put the real value in .env (git-ignored), never here.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# Frontend origin allowed by CORS (empty = no CORS headers).
CORS_ORIGIN=

# First admin, used by `make seed`. Set in .env or the shell, not here.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Where visit photos are stored (private local directory; never expose it as a static route).
PHOTO_DIR=data/photos

# Daily retention job inside the API (photos and personal data expire). Set RETENTION_ENABLED=false
# only if you schedule cmd/retention yourself. RETENTION_RUN_AT is HH:MM in WIB.
RETENTION_ENABLED=true
RETENTION_RUN_AT=02:00

# Email to the house owner when a guest is recorded (optional). Leave SMTP_HOST empty to turn it off.
# With SMTP_HOST set, SMTP_FROM is required; SMTP_USERNAME and SMTP_PASSWORD go together. Port 465 uses
# TLS from the start, any other port needs STARTTLS (a login is never sent over plaintext).
# Put the real password in .env (git-ignored), never here.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Buku Tamu <noreply@example.com>
