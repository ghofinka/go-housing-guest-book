# Normalize line endings to LF in the repo and in working copies (Windows and Linux alike).
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
